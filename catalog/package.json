[
  {
    "id": "MikanseiLaboratory.NDIPlugin",
    "name": "NDIライブ送出",
    "type": "出力プラグイン",
    "summary": "AviUtl2にNDI®の映像送出機能を追加します。",
    "description": "https://raw.githubusercontent.com/MikanseiLaboratory/aviutl2-network-video-output/refs/heads/main/README.md",
    "author": "未完成成果物研究所",
    "repoURL": "https://github.com/MikanseiLaboratory/aviutl2-network-video-output",
    "latest-version": "v0.1.0",
    "licenses": [
      {
        "type": "MIT",
        "isCustom": false,
        "copyrights": [
          {
            "years": "2026",
            "holder": "MikanseiLaboratory"
          }
        ],
        "licenseBody": null
      }
    ],
    "tags": ["配信", "NDI"],
    "dependencies": [],
    "images": [],
    "installer": {
      "source": {
        "direct": null,
        "github": {
          "owner": "MikanseiLaboratory",
          "repo": "aviutl2-network-video-output",
          "pattern": "^aviutl2-network-video-output-v.*\\.au2pkg\\.zip$"
        }
      },
      "install": [
        { "action": "download" },
        { "action": "extract" },
        {
          "action": "copy",
          "from": "{tmp}/Plugin",
          "to": "{pluginsDir}"
        },
        {
          "action": "copy",
          "from": "{tmp}/Language",
          "to": "{dataDir}/Language"
        }
      ],
      "uninstall": [
        {
          "action": "delete",
          "path": "{pluginsDir}/aviutl2_ndi_live_output.aux2"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/Processing.NDI.Lib.x64.dll"
        },
        {
          "action": "delete",
          "path": "{pluginsDir}/aviutl2_ndi_live_output"
        },
        {
          "action": "delete",
          "path": "{dataDir}/Language/English.aviutl2_ndi_live_output.aul2"
        },
        {
          "action": "delete",
          "path": "{dataDir}/Language/Japanese.aviutl2_ndi_live_output.aul2"
        }
      ]
    },
    "version": [
      {
        "version": "v0.1.0",
        "release_date": "2026-08-16",
        "file": [
          {
            "path": "{pluginsDir}/aviutl2_ndi_live_output.aux2",
            "XXH3_128": "00000000000000000000000000000000"
          }
        ]
      }
    ]
  }
]
