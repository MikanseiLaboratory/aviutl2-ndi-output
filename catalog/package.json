{
  "id": "MikanseiLaboratory.aviutl2-ndi-output",
  "name": "AviUtl2 Network Video Output",
  "type": "汎用プラグイン",
  "summary": "NDI®送出プラグイン",
  "description": "./md/MikanseiLaboratory.aviutl2-ndi-output.md",
  "author": "未完成成果物研究所",
  "repoURL": "https://github.com/MikanseiLaboratory/aviutl2-ndi-output",
  "latest-version": "v0.1.0",
  "licenses": [
    {
      "type": "MIT",
      "isCustom": false,
      "copyrights": [
        {
          "years": "2026",
          "holder": "未完成成果物研究所"
        }
      ],
      "licenseBody": null
    }
  ],
  "tags": [
    "配信",
    "NDI"
  ],
  "dependencies": [],
  "images": [
    {
      "thumbnail": "./image/MikanseiLaboratory.aviutl2-ndi-output_thumbnail.png"
    }
  ],
  "installer": {
    "source": {
      "github": {
        "owner": "MikanseiLaboratory",
        "repo": "aviutl2-ndi-output",
        "pattern": "^aviutl2-ndi-output-v.*\\.au2pkg\\.zip$"
      }
    },
    "install": [
      {
        "action": "download"
      },
      {
        "action": "extract"
      },
      {
        "action": "copy",
        "from": "{tmp}/Plugin",
        "to": "{pluginsDir}"
      },
      {
        "action": "copy",
        "from": "{tmp}/Language",
        "to": "{appDir}/Language"
      }
    ],
    "uninstall": [
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output.aux2"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/Processing.NDI.Lib.x64.dll"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/LICENSE"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/THIRD_PARTY_NOTICES.md"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/NDI_TERMS.txt"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/README.md"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/Processing.NDI.Lib.x64.dll"
      },
      {
        "action": "delete",
        "path": "{pluginsDir}/aviutl2_ndi_live_output/Processing.NDI.Lib.Licenses.txt"
      },
      {
        "action": "delete",
        "path": "{appDir}/Language/English.aviutl2_ndi_live_output.aul2"
      },
      {
        "action": "delete",
        "path": "{appDir}/Language/Japanese.aviutl2_ndi_live_output.aul2"
      }
    ]
  },
  "version": [
    {
      "version": "v0.1.0",
      "release_date": "2026-08-16",
      "file": [
        {
          "path": "{pluginsDir}/aviutl2_ndi_live_output.aux2",
          "XXH3_128": "REPLACE_AFTER_GITHUB_RELEASE"
        }
      ]
    }
  ]
}
